// Optional arguments with and without a default value.
// Target: a declaration per prefix (all, without `size`, neither), not `= definedExternally`: Kotlin/Wasm would pass
// `undefined` for a defaulted argument, and a JavaScript call should carry only the arguments given.
typedef [EnforceRange] unsigned long long GPUSize64;
interface GPUBuffer {
    ArrayBuffer getMappedRange(optional GPUSize64 offset = 0, optional GPUSize64 size);
};
